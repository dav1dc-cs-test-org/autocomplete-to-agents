# Copy to .env and fill in. Never commit the real values.

# Where the SQLite database lives.
FREIGHTLINE_DB=var/freightline.db

# HMAC secret carriers sign inbound webhook bodies with.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FREIGHTLINE_WEBHOOK_SECRET=

# Bearer token for /v1/admin. The admin surface fails closed when this is unset.
FREIGHTLINE_ADMIN_TOKEN=

FREIGHTLINE_CURRENCY=USD
FREIGHTLINE_CARRIER_TIMEOUT=5.0
FREIGHTLINE_MAX_PAGE_SIZE=200
